# Podman Quadlet unit (rootless). Install to ~/.config/containers/systemd/
# then: systemctl --user daemon-reload && systemctl --user start fsakel-com
[Unit]
Description=fsakel.com static site

[Container]
Image=localhost/fsakel-com:latest
PublishPort=127.0.0.1:8080:8080
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always

[Install]
WantedBy=default.target
