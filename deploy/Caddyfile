# In-container static server. TLS and the public domain are handled by the
# host's Caddy, which reverse-proxies to this container on 127.0.0.1:3000.
{
	admin off
	auto_https off
	persist_config off
	storage file_system /tmp/caddy
}

:3000 {
	root * /srv
	encode zstd gzip

	# script-src 'sha256-…': the SHA-256 of the one inline script:
	# src/scripts/vt.js + neu.js as BaseLayout.astro inlines them (whole-line
	# comments stripped). Only a script with exactly those bytes may run inline.
	# After editing either, `pnpm check` fails and prints the new hash to paste
	# here.
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'sha256-P8FxC9WGzXJUmsn1bTA/bZ6pmfpmvgCJon3YTIlbwCs='; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@small path /favicon.svg
	header @small Cache-Control "public, max-age=86400"

	@html path / *.html */
	header @html Cache-Control "no-cache"
	# Prerender same-site pages on hover/pointerdown so a click swaps in an
	# already-loaded page (Chromium). Sent as a header so the CSP needs no
	# second inline-script hash.
	header @html Speculation-Rules "\"/speculation-rules.json\""

	@rules path /speculation-rules.json
	header @rules Content-Type application/speculationrules+json
	header @rules Cache-Control "public, max-age=86400"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
