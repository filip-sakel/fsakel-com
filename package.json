{
  "name": "fsakel-com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro build && ${CONTAINER:-podman} run --rm --name fsakel-serve -p ${HOST:-127.0.0.1}:3000:3000 -v ./dist:/srv:ro,Z -v ./deploy/Caddyfile:/etc/caddy/Caddyfile:ro,Z docker.io/library/caddy:2-alpine",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:lighthouse": "node scripts/lighthouse.mjs",
    "check": "astro check && astro build && node scripts/perf-budget.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "astro": "7.4.4",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/tabler": "^1.2.43",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
