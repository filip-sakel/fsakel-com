---
import '@fontsource-variable/hanken-grotesk';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/neu.css';
import vtSource from '../scripts/vt.js?raw';
import neuSource from '../scripts/neu.js?raw';
import hankenLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

import { Icon } from 'astro-icon/components';
import Nav from '../components/Nav.astro';
import { site, social } from '../data/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Inlined (not /vt.js) so the page never waits on a script request. vt.js's
// `pagereveal` listener must exist before the first render, so it can't be
// deferred; neu.js rides along in the same tag. Whole-line comments are
// stripped; the CSP allows the result by hash (deploy/Caddyfile), which
// `pnpm check` verifies.
const inlineJs = [vtSource, neuSource].map((s) => s.replace(/^\s*\/\/.*\n/gm, '').trim()).join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={hankenLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#efe5d1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1a16" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline set:html={inlineJs} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <ul class="contact" role="list">
        {
          social.map((s) => (
            <li>
              <a class="neu" href={s.href} rel="me noopener">
                <span class="neu-face">
                  <Icon name={s.icon} size={20} aria-hidden="true" />
                  <span>{s.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fine">© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xl);
    padding: var(--space-xl) var(--gutter) var(--space-l);
    border-top: 1px solid var(--color-line);
    text-align: center;

    & h2 {
      font-size: var(--step-1);
    }
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-xs);

    & a {
      display: flex;
      align-items: center;
      gap: 0.5em;
      min-height: 2.75rem;
      padding: 0 var(--space-m) 0 var(--space-s);
      /* Raised button (src/styles/neu.css). */
      border: 1px solid transparent;
      border-radius: 0.8rem;
      text-decoration: none;
    }
  }

  .fine {
    margin-top: var(--space-s);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
