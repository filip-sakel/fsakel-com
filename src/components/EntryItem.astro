---
/** One entry as a list item, used on /projects/ and /education/. */
import type { Entry } from '../data/content';
import { formatRange, hasWriteUp } from '../data/content';
import { skillId } from '../data/skills';

interface Props {
  entry: Entry;
  /** `details` (fuller bullets) or `summary`. */
  bullets?: 'details' | 'summary';
  /** Heading level for the title; pick whatever follows the page outline. */
  level?: 2 | 3;
}
const { entry, bullets = 'details', level = 3 } = Astro.props;
const Heading = `h${level}` as const;
const { title, org, course, start, end, location, summary, details, links, skills, draft, kind } = entry.data;
const items = bullets === 'details' ? (details ?? summary) : summary;
const meta = [formatRange(start, end), location].filter(Boolean).join(' · ');
---

<li class="item" id={entry.id} data-draft={draft || undefined}>
  <div class="head">
    <Heading class="title">
      {course && <span class="course">{course}</span>}
      {hasWriteUp(entry) ? <a href={`/projects/${entry.id}/`}>{title}</a> : title}
      {org && <span class="org">, {org}</span>}
      {kind === 'award' && <span class="badge">Award</span>}
      {draft && <span class="badge draft">Draft</span>}
    </Heading>
    {meta && <p class="meta">{meta}</p>}
  </div>
  {
    items.length > 0 && (
      <ul class="bullets">
        {items.map((d) => (
          <li>{d}</li>
        ))}
      </ul>
    )
  }
  {
    (links.length > 0 || skills.length > 0) && (
      <p class="foot">
        {links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
        {skills.length > 0 && (
          <span class="skills">
            <span class="visually-hidden">Skills: </span>
            {skills.map((s, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={`/education/#${skillId(s)}`}>{s}</a>
              </>
            ))}
          </span>
        )}
      </p>
    )
  }
</li>

<style>
  .item {
    scroll-margin-top: calc(var(--nav-h) + var(--space-m));

    &:target .title {
      color: var(--color-accent);
    }
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-m);

    & .title {
      font-size: var(--step-1);
      transition: color 0.3s;
    }
  }

  .course {
    margin-right: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.75em;
    font-weight: 500;
    color: var(--color-muted);
  }

  .org {
    font-weight: 400;
  }

  .badge {
    margin-left: 0.5em;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.6em;
    vertical-align: 0.2em;

    &.draft {
      background: var(--color-rail);
      color: var(--color-text);
    }
  }

  .meta,
  .skills {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  /* Skill links: same muted mono text, with a faint underline that
     firms up on hover so they read as links without shouting. */
  .skills a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    transition:
      color 0.15s,
      text-decoration-color 0.15s;

    &:hover {
      color: var(--color-text);
      text-decoration-color: currentColor;
    }
  }

  .bullets {
    margin-top: var(--space-xs);
    padding-left: 1.25rem;
    list-style: square;

    & li + li {
      margin-top: var(--space-2xs);
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
</style>
