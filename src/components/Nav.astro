---
import { Icon } from 'astro-icon/components';
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main">
    <ul role="list">
      {
        nav.map((item) => (
          <li>
            <a class="neu neu-flat" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="neu-face">
                <Icon name={item.icon} size={18} aria-hidden="true" />
                <span class="label">{item.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--nav-h);
    display: grid;
    place-items: center;
    padding-inline: var(--space-xs);
    /* Solid behind the whole button row, then a soft fade below it, so
       scrolled content never shows through the buttons. */
    background: var(--grain), var(--color-bg);
    background-blend-mode: overlay;
    view-transition-name: site-nav;

    &::after {
      content: '';
      position: absolute;
      inset: 100% 0 auto;
      height: var(--space-m);
      background: var(--grain), var(--color-bg);
      background-blend-mode: overlay;
      mask-image: linear-gradient(#000, transparent);
      pointer-events: none;
    }
  }

  ul {
    display: flex;
    gap: clamp(0rem, 1.5vw, 1rem);
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.4em;
    /* 36px: above WCAG 2.2's 24px target minimum, slimmer than before. */
    min-height: 2.25rem;
    padding: 0 clamp(0.55rem, 2.2vw, 1.05rem);
    /* Flat until pressed, sunk when selected (src/styles/neu.css). The
       hairline is the well's edge, as in the design. */
    border: 0.5px solid transparent;
    border-radius: 0.8rem;
    color: var(--color-muted);
    font-size: clamp(0.875rem, 0.8rem + 0.4vw, 1rem);
    text-decoration: none;
    /* iOS otherwise flashes a gray rectangle over the button on tap. */
    -webkit-tap-highlight-color: transparent;

    &:hover {
      color: var(--color-text);
    }

    /* Pressing any item eases it into the well, previewing the selected
       state. */
    &:active,
    &[aria-current='page'] {
      color: var(--color-accent);
    }

    &[aria-current='page'] :global(svg) {
      /* Icon and label sit slightly lower in the well. */
      translate: 0 0.5px;
    }
  }

  /* src/scripts/vt.js holds a clicked item pressed until the next page
     shows, and there marks the item we came from with data-was. */
  a[data-held] {
    --p: 1;
  }

  /* Phones: icons only, plus the selected item's label. Each item gets an
     equal, fixed slot and stays centered in it, so moving the selection
     never shifts the others; the selected well just grows into the slack
     around its icon. Collapsed labels are zero-width, not removed, so every
     link keeps its accessible name. */
  @media (width < 30rem) {
    .site-nav,
    ul {
      width: 100%;
    }

    ul {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 0;
    }

    li {
      display: flex;
      justify-content: center;
    }

    a {
      flex: none;
      justify-content: center;
      gap: 0;
      min-width: 2.75rem;
      padding-inline: 0.5rem;
      white-space: nowrap;
    }

    .label {
      overflow: hidden;
      padding-inline-start: 0.4em;
    }

    a:not([aria-current='page']) .label {
      width: 0;
      padding-inline-start: 0;
      opacity: 0;
    }
  }

  /* Arriving from another nav page: the selection animates over. The old
     item's well eases out and, on phones, its width collapses back to the
     icon while the new item's label grows out of its well. (The nav's own
     page-transition crossfade is off, base.css, so this is what shows.) */
  @media (prefers-reduced-motion: no-preference) {
    .site-nav {
      interpolate-size: allow-keywords;
    }

    a[data-was] {
      animation: nav-unpress 0.3s ease-out;
    }

    @media (width < 30rem) {
      a[data-was] .label {
        animation: nav-label-out 0.3s cubic-bezier(0.2, 0, 0, 1);
      }
      .site-nav:has([data-was]) [aria-current='page'] .label {
        animation: nav-label-in 0.3s cubic-bezier(0.2, 0, 0, 1);
      }
    }
  }

  @keyframes nav-unpress {
    from {
      --p: 1;
    }
  }
  @keyframes nav-label-in {
    from {
      width: 0;
      padding-inline-start: 0;
      opacity: 0;
    }
  }
  @keyframes nav-label-out {
    from {
      width: auto;
      padding-inline-start: 0.4em;
      opacity: 1;
    }
  }

  /* Smallest phones: icon + label outgrows its slot, so the selected item
     shows just its label. */
  @media (width < 22rem) {
    a[aria-current='page'] :global(svg) {
      display: none;
    }
  }
</style>
