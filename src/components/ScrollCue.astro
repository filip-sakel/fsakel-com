---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="scroll-cue" href={href}>
  <span>{label}</span>
  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m5 9 7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .scroll-cue {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    padding-inline: var(--space-s);
    color: var(--color-muted);
    text-decoration: none;

    &:hover {
      color: var(--color-text);
    }
  }

  /* M1: as soon as the page scrolls, the cue lifts and fades (reduced
     motion: blurs out in place); the real heading (Timeline.astro) takes
     over. Static fallback: a jump link.

     The fade runs on the compositor (opacity/translate/filter only).
     Hiding (out of the tab order) is a separate step at the end, since one
     non-compositable property would pull the whole fade onto the main
     thread. */
  @supports (animation-timeline: scroll()) {
    .scroll-cue {
      animation:
        cue-out linear both,
        cue-hide step-end both;
      animation-timeline: scroll(root), scroll(root);
      animation-range: 0 25svh;

      @media (prefers-reduced-motion: reduce) {
        animation-name: cue-blur-out, cue-hide;
      }
    }
  }

  @keyframes cue-out {
    to {
      opacity: 0;
      translate: 0 -1.5rem;
    }
  }

  @keyframes cue-blur-out {
    to {
      opacity: 0;
      filter: blur(6px);
    }
  }

  @keyframes cue-hide {
    to {
      visibility: hidden;
    }
  }
</style>
