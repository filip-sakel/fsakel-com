---
/**
 * Skills grouped by category. A skill used by any entry is a button that
 * opens a popover listing those entries. Popovers are declarative HTML
 * (`popovertarget`), so this works without JavaScript.
 */
import { skillGroups, skillId } from '../data/skills';
import { getSkillUses, entryHref } from '../data/content';

const uses = await getSkillUses();
---

<p class="tip">Tip: click a skill to see where I developed it.</p>
<dl class="groups">
  {
    Object.entries(skillGroups).map(([group, skills]) => (
      <div class="group">
        <dt>{group}</dt>
        <dd>
          <ul role="list">
            {skills.map((skill) => {
              const where = uses.get(skill) ?? [];
              if (where.length === 0) return <li class="skill">{skill}</li>;
              return (
                <li class="has-uses" id={skillId(skill)}>
                  <button class="skill" type="button" popovertarget={`${skillId(skill)}-uses`}>
                    {skill}
                    <span class="count" aria-hidden="true">{where.length}</span>
                    <span class="visually-hidden">, used in {where.length} {where.length === 1 ? 'place' : 'places'}</span>
                  </button>
                  <div class="pop" id={`${skillId(skill)}-uses`} popover>
                    <p class="pop-title">Where I used {skill}</p>
                    <ul role="list">
                      {where.map((e) => (
                        <li>
                          <a href={entryHref(e)}>
                            {e.data.title}
                            {e.data.org && <span>, {e.data.org}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .tip {
    margin-bottom: var(--space-l);
    color: var(--color-muted);
    font-size: var(--step--1);
    text-align: center;
  }

  .groups {
    display: grid;
    gap: var(--space-l);
  }

  dt {
    margin-bottom: var(--space-xs);
    font-weight: 500;
  }

  dd > ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .skill {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.25rem;
    padding: 0 0.85em;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--step--1);
  }

  button.skill {
    border-color: var(--color-raised-edge);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    box-shadow: var(--shadow-raised);
    transition: box-shadow 0.15s, background-color 0.15s;
    anchor-name: --skill;

    &:hover {
      background: var(--color-surface-hover);
    }

    /* Same sunken "pressed" well as the nav. */
    &:active,
    &:has(+ .pop:popover-open) {
      background: var(--well-bg);
      border-color: transparent;
      box-shadow: var(--shadow-well-sm);
    }
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--color-accent);
  }

  .has-uses {
    anchor-scope: --skill;
    scroll-margin-top: calc(var(--nav-h) + var(--space-xl));
  }

  /* Arrived from a project's skill link: ring the skill so it is easy
     to spot among the others. */
  .has-uses:target button.skill {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .pop {
    /* Fallback (no anchor positioning): the browser centers the popover. */
    max-width: min(22rem, calc(100vw - 2rem));
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-raised-edge);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-pop);

    &::backdrop {
      background: transparent;
    }

    & ul {
      display: grid;
      gap: var(--space-2xs);
    }

    & a {
      display: block;
      padding-block: 0.2rem;
    }
  }

  @supports (position-area: bottom) {
    .pop {
      position-anchor: --skill;
      position-area: bottom span-right;
      position-try-fallbacks: flip-block, flip-inline;
      margin: var(--space-2xs) 0 0;
    }
  }

  .pop-title {
    margin-bottom: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
