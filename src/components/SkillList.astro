---
/**
 * Skills grouped by category. Each skill is a button that opens a popover
 * with its note (`skillNotes`) and/or the entries that use it. Popovers are
 * declarative HTML (`popovertarget`), so this works without JavaScript.
 */
import { allSkills, skillGroups, skillId, skillNotes } from '../data/skills';
import { getSkillUses, entryHref } from '../data/content';

const uses = await getSkillUses();

const bare = allSkills.filter((s) => !uses.has(s) && !skillNotes[s]);
if (bare.length) {
  throw new Error(`Skills with no entry and no note (add one to skillNotes in src/data/skills.ts): ${bare.join(', ')}`);
}
---

<p class="tip">Tip: click a skill to see where and how I use it.</p>
<dl class="groups">
  {
    Object.entries(skillGroups).map(([group, skills]) => (
      <div class="group">
        <dt>{group}</dt>
        <dd>
          <ul role="list">
            {skills.map((skill) => {
              const where = uses.get(skill) ?? [];
              const note = skillNotes[skill];
              return (
                <li class="has-pop" id={skillId(skill)}>
                  <button class="skill neu" type="button" popovertarget={`${skillId(skill)}-uses`}>
                    <span class="neu-face">
                      {skill}
                      {where.length > 0 && <span class="count" aria-hidden="true">{where.length}</span>}
                    </span>
                    {where.length > 0 && (
                      <span class="visually-hidden">, used in {where.length} {where.length === 1 ? 'place' : 'places'}</span>
                    )}
                  </button>
                  <div class="pop" id={`${skillId(skill)}-uses`} popover>
                    {note && <p class="pop-note">{note}</p>}
                    {where.length > 0 && (
                      <>
                        <p class="pop-title">Where I used {skill}</p>
                        <ul role="list">
                          {where.map((e) => (
                            <li>
                              <a href={entryHref(e)}>
                                {e.data.title}
                                {e.data.org && <span>, {e.data.org}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .tip {
    margin-bottom: var(--space-l);
    color: var(--color-muted);
    font-size: var(--step--1);
    text-align: center;
  }

  .groups {
    display: grid;
    gap: var(--space-l);
  }

  dt {
    margin-bottom: var(--space-xs);
    font-weight: 500;
  }

  dd > ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* Raised button, sunk while its popover is open (src/styles/neu.css). */
  .skill {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.25rem;
    padding: 0 0.85em;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--step--1);
    anchor-name: --skill;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--color-accent);
  }

  .has-pop {
    anchor-scope: --skill;
    scroll-margin-top: calc(var(--nav-h) + var(--space-xl));
  }

  /* Arrived from a project's skill link: ring the skill so it is easy
     to spot among the others. */
  .has-pop:target button.skill {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .pop {
    /* Fallback (no anchor positioning): the browser centers the popover. */
    max-width: min(22rem, calc(100vw - 2rem));
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-raised-edge);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-pop);

    &::backdrop {
      background: transparent;
    }

    & ul {
      display: grid;
      gap: var(--space-2xs);
    }

    & a {
      display: block;
      padding-block: 0.2rem;
    }
  }

  @supports (position-area: bottom) {
    .pop {
      position-anchor: --skill;
      position-area: bottom span-right;
      position-try-fallbacks: flip-block, flip-inline;
      margin: var(--space-2xs) 0 0;
    }
  }

  .pop-note {
    font-size: var(--step--1);
    line-height: 1.5;

    &:not(:last-child) {
      margin-bottom: var(--space-s);
    }
  }

  .pop-title {
    margin-bottom: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
