---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHobbies, hasWriteUp } from '../../data/content';

const hobbies = await getHobbies();

// Rendered photo widths (see .cards / .photos below). One column until the
// wrap fits two 17rem cards (~38rem viewport); past that a card's inner width
// tops out near 22rem. A lone/leading photo spans the card, others half of it.
const sizes = {
  full: '(width >= 38rem) 22rem, calc(100vw - 4.5rem)',
  half: '(width >= 38rem) 11rem, calc(50vw - 2.5rem)',
  // Expanded view: as wide as the viewport allows (see .zoomed below).
  zoomed: 'min(100vw - 2rem, 1600px)',
};
---

<BaseLayout title="Hobbies" description="Running, swimming, biking, public transit, and open source.">
  <div class="page wrap">
    <h1>Hobbies</h1>
    <ul class="cards" role="list">
      {
        hobbies.map((h, hi) => (
          <li class="card" id={h.id}>
            <h2>
              {h.data.icon && <Icon name={h.data.icon} size={22} aria-hidden="true" />}
              {hasWriteUp(h) ? <a href={`/hobbies/${h.id}/`}>{h.data.title}</a> : h.data.title}
            </h2>
            <p>{h.data.blurb}</p>
            {h.data.photos.length > 0 && (
              <div class="photos">
                {h.data.photos.map((p, pi) => (
                  <figure>
                    {/* Click to expand: a modal <dialog> opened by HTML invoker
                        commands (no JS). Its image is lazy, so it loads only
                        once opened. Browsers without invoker commands just
                        show the thumbnail. */}
                    <button class="zoom" type="button" commandfor={`${h.id}-photo-${pi}`} command="show-modal">
                      <Image
                        src={p.src}
                        alt={p.alt}
                        widths={[240, 360, 480, 640, 800]}
                        sizes={pi === 0 && h.data.photos.length % 2 === 1 ? sizes.full : sizes.half}
                        format="avif"
                        quality="mid"
                        priority={hi === 0 && pi === 0}
                      />
                      <span class="visually-hidden">, enlarge</span>
                    </button>
                    {p.caption && <figcaption>{p.caption}</figcaption>}
                    <dialog class="zoomed" id={`${h.id}-photo-${pi}`} closedby="any" aria-label={p.caption ?? p.alt}>
                      <button type="button" commandfor={`${h.id}-photo-${pi}`} command="close">
                        <Image src={p.src} alt={p.alt} widths={[800, 1200, 1600]} sizes={sizes.zoomed} format="avif" quality="mid" />
                        <span class="visually-hidden">Close</span>
                      </button>
                      {p.caption && <p>{p.caption}</p>}
                    </dialog>
                  </figure>
                ))}
              </div>
            )}
            {h.data.links.length > 0 && (
              <ul class="links" role="list">
                {h.data.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-l);

    & h1 {
      font-size: var(--step-3);
      margin-bottom: var(--space-xl);
      text-align: center;
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
  }

  .card {
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-s);
    background: var(--color-surface);

    & h2 {
      display: flex;
      align-items: center;
      gap: 0.45em;
      margin-bottom: var(--space-xs);
      font-size: var(--step-1);

      & svg {
        color: var(--color-accent);
        flex: none;
      }
    }

    & p {
      color: var(--color-muted);
    }
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: var(--space-xs);
    margin-top: var(--space-s);

    /* With an odd count, the first photo leads at full width. */
    & figure:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }

    & .zoom {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
      cursor: zoom-in;

      &:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }
    }

    & .zoom img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: calc(var(--radius-s) - 2px);
      /* Placeholder: the page lays out and paints at once; until a photo
         arrives its frame shows as a sunken well with the same hairline
         as the hero photo. (The CSP forbids per-image inline styles, so
         no per-photo color/blur preview.) */
      background: var(--well-bg);
      outline: 0.5px solid var(--color-photo-stroke);
      outline-offset: -0.5px;
    }

    & figcaption {
      margin-top: 0.3rem;
      color: var(--color-muted);
      font-size: var(--step--1);
      line-height: 1.3;
    }
  }

  /* Keep the page behind an open photo from scrolling. */
  :global(html:has(dialog.zoomed:modal)) {
    overflow: hidden;
  }

  /* Expanded photo, centered in the top layer over a dimmed page. */
  .zoomed {
    /* The global reset zeroes margins; auto restores the UA centering. */
    margin: auto;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;

    &::backdrop {
      background: rgb(0 0 0 / 0.8);
    }

    & button {
      display: block;
      padding: 0;
      border: 0;
      background: none;
      cursor: zoom-out;
    }

    & img {
      display: block;
      width: auto;
      height: auto;
      max-width: calc(100vw - 2rem);
      max-height: calc(100dvh - 5rem);
      border-radius: var(--radius-s);
    }

    & p {
      margin-top: var(--space-xs);
      color: #fff;
      font-size: var(--step--1);
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .zoomed,
    .zoomed::backdrop {
      transition:
        opacity 0.2s,
        display 0.2s allow-discrete,
        overlay 0.2s allow-discrete;
      opacity: 0;
    }

    .zoomed:open,
    .zoomed:open::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }
</style>
