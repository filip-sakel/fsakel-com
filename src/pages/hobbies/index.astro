---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHobbies, hasWriteUp } from '../../data/content';

const hobbies = await getHobbies();

// Rendered photo widths (see .cards / .photos below). One column until the
// wrap fits two 17rem cards (~38rem viewport); past that a card's inner width
// tops out near 22rem. A lone/leading photo spans the card, others half of it.
const sizes = {
  full: '(width >= 38rem) 22rem, calc(100vw - 4.5rem)',
  half: '(width >= 38rem) 11rem, calc(50vw - 2.5rem)',
};
---

<BaseLayout title="Hobbies" description="Running, swimming, biking, public transit, and open source.">
  <div class="page wrap">
    <h1>Hobbies</h1>
    <ul class="cards" role="list">
      {
        hobbies.map((h, hi) => (
          <li class="card" id={h.id}>
            <h2>
              {h.data.icon && <Icon name={h.data.icon} size={22} aria-hidden="true" />}
              {hasWriteUp(h) ? <a href={`/hobbies/${h.id}/`}>{h.data.title}</a> : h.data.title}
            </h2>
            <p>{h.data.blurb}</p>
            {h.data.photos.length > 0 && (
              <div class="photos">
                {h.data.photos.map((p, pi) => (
                  <figure>
                    <Image
                      src={p.src}
                      alt={p.alt}
                      widths={[240, 360, 480, 640, 800]}
                      sizes={pi === 0 && h.data.photos.length % 2 === 1 ? sizes.full : sizes.half}
                      format="avif"
                      quality="mid"
                      priority={hi === 0 && pi === 0}
                    />
                    {p.caption && <figcaption>{p.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
            {h.data.links.length > 0 && (
              <ul class="links" role="list">
                {h.data.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-l);

    & h1 {
      font-size: var(--step-3);
      margin-bottom: var(--space-xl);
      text-align: center;
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
  }

  .card {
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-s);
    background: var(--color-surface);

    & h2 {
      display: flex;
      align-items: center;
      gap: 0.45em;
      margin-bottom: var(--space-xs);
      font-size: var(--step-1);

      & svg {
        color: var(--color-accent);
        flex: none;
      }
    }

    & p {
      color: var(--color-muted);
    }
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: var(--space-xs);
    margin-top: var(--space-s);

    /* With an odd count, the first photo leads at full width. */
    & figure:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }

    & img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: calc(var(--radius-s) - 2px);
      /* Placeholder: the page lays out and paints at once; until a photo
         arrives its frame shows as a sunken well with the same hairline
         as the hero photo. (The CSP forbids per-image inline styles, so
         no per-photo color/blur preview.) */
      background: var(--well-bg);
      outline: 0.5px solid var(--color-photo-stroke);
      outline-offset: -0.5px;
    }

    & figcaption {
      margin-top: 0.3rem;
      color: var(--color-muted);
      font-size: var(--step--1);
      line-height: 1.3;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }
</style>
