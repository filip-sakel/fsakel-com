---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import EducationList from '../components/EducationList.astro';
import { homeSections } from '../data/site';
import { getHighlights } from '../data/content';

const highlights = await getHighlights();
---

<BaseLayout>
  {
    homeSections.map((section) => {
      switch (section) {
        case 'hero':
          return <Hero />;
        case 'highlights':
          return <Timeline id="highlights" title="Project Highlights" entries={highlights} />;
        case 'education':
          return <EducationList />;
      }
    })
  }
</BaseLayout>
