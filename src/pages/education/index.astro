---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryItem from '../../components/EntryItem.astro';
import SkillList from '../../components/SkillList.astro';
import { getEntries, getSchools } from '../../data/content';

const schools = await getSchools();
const entries = await getEntries();
---

<BaseLayout title="Education & Skills" description="Education, coursework, and skills of Filip Sakellariou.">
  <div class="page wrap">
    <h1>Education &amp; Skills</h1>

    {
      schools.map((school) => {
        const items = entries.filter((e) => e.data.school?.id === school.id);
        const { data } = school;
        return (
          <section class="school" id={school.id} aria-labelledby={`${school.id}-title`}>
            <header>
              <div class="head">
                <h2 id={`${school.id}-title`}>{data.school}</h2>
                {data.when && <p class="meta">{data.when}</p>}
              </div>
              <p>
                {data.degree}
                {data.location && <span class="meta"> · {data.location}</span>}
              </p>
              {data.notes.map((n) => <p class="note">{n}</p>)}
            </header>
            {items.length > 0 && (
              <ul class="list" role="list">
                {items.map((entry) => <EntryItem entry={entry} />)}
              </ul>
            )}
          </section>
        );
      })
    }

    <section class="skills" id="skills" aria-labelledby="skills-title">
      <h2 class="section-title" id="skills-title">Skills</h2>
      <SkillList />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max);
    padding-top: var(--space-l);

    & h1 {
      font-size: var(--step-3);
      margin-bottom: var(--space-xl);
    }
  }

  .school + .school,
  .skills {
    margin-top: var(--space-2xl);
  }

  .school header {
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-m);

    & h2 {
      font-size: var(--step-2);
    }
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .note {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .list {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-l);
  }

  .skills .section-title {
    margin-bottom: var(--space-xs);
  }
</style>
